# Google OAuth Client ID for frontend login button
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# URL of the deployed backend API (omit to fallback to relative /api routing if hosted together)
# For separate Render deployments, set this to your backend service URL: https://your-backend-service.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api
