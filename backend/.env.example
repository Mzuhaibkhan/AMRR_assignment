# Google OAuth Client ID for verification
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Comma-separated list of Resend API keys for email reminders (with free tier fallback)
RESEND_API_KEYS=re_key1_abc123,re_key2_xyz789

# Sender email address registered/verified with Resend
EMAIL_FROM=Orbit Tasks <onboarding@resend.dev>

# Secret token to secure the cron reminder trigger endpoint
CRON_SECRET=generate-a-long-random-string-here
